# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Gemini API key.
#   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)
# Get a key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

# --- AI Layer (LangGraph + Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT=60
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_DELAY=1.0
# Tried in order when the primary model is busy or out of quota.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Optional: run the router on a different model so it uses a separate
# per-minute quota bucket (the free tier allows only a few requests/min/model).
GEMINI_ROUTER_MODEL=
# 0 = disable the model's reasoning pass (much faster replies)
GEMINI_THINKING_BUDGET=0

# --- Backend (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_TRACE_HISTORY=50

# --- Frontend (Node) ---
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8000
