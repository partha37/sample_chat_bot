# Normalise line endings: check them in as LF, check them out per platform.
* text=auto eol=lf

# Force LF for scripts that must run on Linux/macOS too.
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - do not try to diff them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary
